# Required
ANTHROPIC_API_KEY=sk-ant-...
# Must match APP_SHARED_SECRET in the app's src/App.jsx.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SHARED_SECRET=a77fe61d4b009cecaf73a0d3ab4cb981a3e30f6a414421d537e639b617ee8952


# Optional
ANTHROPIC_MODEL=claude-sonnet-5
PORT=8787
# Comma-separated. Defaults are the Capacitor WebView origins. Use * only for local dev.
ALLOWED_ORIGINS=https://localhost,capacitor://localhost,http://localhost
# Requests per client IP
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=150
# Set true when running behind a proxy/load balancer (Render, Fly, Vercel, nginx...)
TRUST_PROXY=false
# Reject system prompts the app doesn't ship with (recommended). Set true only for local experiments.
ALLOW_CUSTOM_SYSTEM=false
# If a request contains self-harm language, answer with fixed crisis-resource text instead of calling the model
CRISIS_BACKSTOP=true
