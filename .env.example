# Required
ANTHROPIC_API_KEY=sk-ant-...
# Must match APP_SHARED_SECRET in the app's src/App.jsx.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SHARED_SECRET=change-me

# Optional
# Only needed if your API key is not scoped to a workspace (Anthropic will return
# a 400 asking for this header). Find the ID in the console URL for your workspace.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-5
PORT=8787
ALLOWED_ORIGINS=https://localhost,capacitor://localhost,http://localhost
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=150
TRUST_PROXY=false
ALLOW_CUSTOM_SYSTEM=false
CRISIS_BACKSTOP=true
