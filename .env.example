# Requests per client IP
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=150
# Set true when running behind a proxy/load balancer (Render, Fly, Vercel, nginx...)
TRUST_PROXY=false
# Reject system prompts the app doesn't ship with (recommended). Set true only for local experiments.
ALLOW_CUSTOM_SYSTEM=false
# If a request contains self-harm language, answer with fixed crisis-resource text instead of calling the model
CRISIS_BACKSTOP=true
